# Copy to .env.local to change how the front end reaches the back end.
#
# Default (no file needed): the page calls /api on its own origin, and Vite passes those requests
# to the back end on http://127.0.0.1:8000. Start Uvicorn first, then `npm run dev`.
#
# VITE_API_BASE: set to the back end's address to skip the proxy (the back end then needs CORS
# to allow this page's origin), for example http://localhost:8000.
VITE_API_BASE=
# VITE_API_MODE: `mock` runs every screen on the in-browser mock with illustrative data, with no
# back end. Leave unset, or `http`, to use the back end.
VITE_API_MODE=http
